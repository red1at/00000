---
import { NAV, SITE } from '../config/site';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name} — accueil`}>
      <img src="/images/logo.png" alt={`Logo IPTV Smarters Pro — abonnement IPTV France`} width="108" height="40" />
    </a>
    <nav aria-label="Navigation principale">
      <button class="hamburger" aria-label="Ouvrir le menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links">
        {NAV.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li class="nav-cta">
          <a class="btn btn-red" href="/#tarifs">Commander IPTV</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
