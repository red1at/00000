---
export interface FaqItem {
  q: string;
  a: string; // may contain simple inline HTML (strong, a)
}
interface Props {
  items: FaqItem[];
  h3?: boolean; // use H3 for questions (inside sections) vs H2
}
const { items, h3 = true } = Astro.props;
const Tag = h3 ? 'h3' : 'h2';
---

<div class="faq">
  {items.map((item) => (
    <details>
      <summary><span>{item.q}</span></summary>
      <div class="faq-body"><p set:html={item.a} /></div>
    </details>
  ))}
</div>
